# Картотека доставчици – защита на файловете
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config(\.sample)?\.php|composer\.(json|lock)|README\.md|.*\.sql|\.git.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 32M
</IfModule>

# Пренасочване към HTTPS. Махнете # пред трите реда, след като включите SSL сертификат в cPanel.
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
